# Spring Boot Backend Environment Variables
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (for PostgreSQL / production)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartquote
SPRING_DATASOURCE_USERNAME=smartquote
SPRING_DATASOURCE_PASSWORD=your_secure_password_here
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# JWT Authentication Secret (Must be at least 256 bits / 32 characters in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app
